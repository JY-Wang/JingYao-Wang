---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<MainLayout title="Blog | JingYao Wang" description="Notes by JingYao Wang.">
  <Header />

  <main class="page">
    <section class="page-header">
      <h2>Blog</h2>
      <p class="lead">Notes about AI, knowledge systems, technology, and personal systems.</p>
    </section>

    <section class="project-list">
      {sortedPosts.length > 0 ? (
        sortedPosts.map((post) => (
          <a class="card" href={`/blog/${post.id}`}>
            <p class="status">{post.data.date.toLocaleDateString("zh-CN")}</p>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            {post.data.tags && (
              <div class="tags">
                {post.data.tags.map((tag) => <span>{tag}</span>)}
              </div>
            )}
          </a>
        ))
      ) : (
        <div class="card">
          <h3>No posts yet</h3>
          <p>Add Markdown files to src/content/blog.</p>
        </div>
      )}
    </section>
  </main>

  <Footer />
</MainLayout>