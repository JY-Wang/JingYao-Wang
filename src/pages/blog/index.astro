---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<MainLayout title="Blog | JingYao Wang" description="关于 AI、知识系统、软件与生活的全部文章。">
  <Header compact />
  <main class="page-shell">
    <div class="page-intro">
      <p class="eyebrow">ALL WRITING</p>
      <h2>Blog</h2>
      <p>关于 AI、知识系统、软件创造，以及如何更清醒地使用技术。</p>
    </div>
    <div class="post-list">
      {posts.map((post) => (
        <a class="post-row" href={`/blog/${post.id}`}>
          <time>{post.data.date.toLocaleDateString("zh-CN")}</time>
          <div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
          <span>→</span>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</MainLayout>
