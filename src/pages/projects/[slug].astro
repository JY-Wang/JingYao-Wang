---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content } = await render(project);
---

<MainLayout title={`${project.data.title} | JingYao Wang`} description={project.data.description}>
  <Header />

  <main class="page article-page">
    <a class="back-link" href="/projects">Back to Projects</a>

    <section class="page-header">
      <h2>{project.data.title}</h2>
      <p class="lead">{project.data.description}</p>
      {project.data.tags && (
        <div class="tags">
          {project.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </section>

    <article class="card prose">
      <Content />
    </article>
  </main>

  <Footer />
</MainLayout>