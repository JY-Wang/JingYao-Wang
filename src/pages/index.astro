---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<MainLayout title="JingYao Wang | AI · Code · Life" description="JingYao Wang 的个人博客，记录 AI、知识系统与软件创造。">
  <Header />

  <main>
    <section class="section latest-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">LATEST BLOG</p>
            <h2>最近的思考</h2>
          </div>
          <a class="text-link" href="/blog">查看全部文章 →</a>
        </div>

        <div class="post-grid">
          {latestPosts.map((post) => (
            <a class="post-card" href={`/blog/${post.id}`}>
              <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("zh-CN")}</time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span>阅读文章 →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section about-strip">
      <div class="container narrow">
        <p class="eyebrow">ABOUT</p>
        <h2>在技术与人的尺度之间</h2>
        <p>我关注人工智能、个人知识系统与软件创造，也在持续构建 JYOS——一个帮助人与 AI 长期协作的个人操作系统。</p>
      </div>
    </section>

    <section id="contact" class="section contact-section">
      <div class="container">
        <p class="eyebrow">CONTACT</p>
        <h2>找到我</h2>
        <div class="contact-list">
          <a href="https://github.com/JY-Wang" target="_blank" rel="noreferrer"><i class="fa-brands fa-github"></i><span>GitHub</span><small>github.com/JY-Wang</small></a>
          <a href="https://gitlab.com/JY-Wang" target="_blank" rel="noreferrer"><i class="fa-brands fa-gitlab"></i><span>GitLab</span><small>gitlab.com/JY-Wang</small></a>
          <a href="https://huggingface.co/JY-Wang" target="_blank" rel="noreferrer"><i class="fa-solid fa-face-smile"></i><span>Hugging Face</span><small>huggingface.co/JY-Wang</small></a>
          <a href="mailto:hi@jingyao.wang"><i class="fa-solid fa-envelope"></i><span>Email</span><small>hi@jingyao.wang</small></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>
