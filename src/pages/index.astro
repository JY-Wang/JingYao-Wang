---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");
const latestPosts = posts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<MainLayout>
  <Header />

  <main>
    <section id="about">
      <div class="container section-inner">
        <h2>About Me</h2>

        <p>我是 JingYao Wang，一名独立创造者。</p>
        <p>关注人工智能、个人知识管理、软件开发，以及技术与自然结合的新生活方式。</p>
        <p>正在构建 JYOS（JingYao Operating System），探索人与 AI 长期协作的新模式。</p>
      </div>
    </section>

    <section id="projects-overview">
      <div class="container section-inner">
        <h2>Projects</h2>

        <div class="card-grid">
          <article class="card">
            <h3>JYOS</h3>
            <p>JingYao Operating System。个人知识、认知模型与 AI 协作系统。</p>
          </article>

          <article class="card">
            <h3>AI Tools</h3>
            <p>探索 AI 自动化、智能助手和个人生产力工具。</p>
          </article>

          <article class="card">
            <h3>Personal Studio</h3>
            <p>Building · Creating · Exploring</p>
          </article>
        </div>

        <p class="section-link">
          <a href="/projects">View all projects →</a>
        </p>
      </div>
    </section>

    <section id="blog-overview">
      <div class="container section-inner">
        <h2>Blog</h2>

        <div class="card-grid">
          {latestPosts.map((post) => (
            <a class="card preview-card" href={`/blog/${post.id}`}>
              <p class="status">{post.data.date.toLocaleDateString("zh-CN")}</p>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>

        <p class="section-link">
          <a href="/blog">Read all posts →</a>
        </p>
      </div>
    </section>

    <section id="contact">
      <div class="container section-inner">
        <h2>Contact</h2>

        <div class="contact-list">
          <div class="contact-item">
            <i class="fa-solid fa-globe" aria-hidden="true"></i>
            <a href="https://jingyao.wang" target="_blank" rel="noreferrer">jingyao.wang</a>
          </div>

          <div class="contact-item">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
            <a href="https://github.com/JY-Wang" target="_blank" rel="noreferrer">github.com/JY-Wang</a>
          </div>

          <div class="contact-item">
            <i class="fa-brands fa-gitlab" aria-hidden="true"></i>
            <a href="https://gitlab.com/JY-Wang" target="_blank" rel="noreferrer">gitlab.com/JY-Wang</a>
          </div>

          <div class="contact-item">
            <i class="fa-solid fa-face-smile" aria-hidden="true"></i>
            <a href="https://huggingface.co/JY-Wang" target="_blank" rel="noreferrer">huggingface.co/JY-Wang</a>
          </div>

          <div class="contact-item">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            <a href="mailto:hi@jingyao.wang">hi@jingyao.wang</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <p>© 2026 JingYao Wang</p>
  </footer>
</MainLayout>